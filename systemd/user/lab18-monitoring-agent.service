[Unit]
Description=Lab18 Monitoring Agent Healthcheck
# Project documentation: docs/operations/lab18b-agent-zielbild-rechtemodell.md
Documentation=man:systemd.service(5)

[Service]
Type=oneshot
WorkingDirectory=%h/projects/ubuntu-lab-baseline
